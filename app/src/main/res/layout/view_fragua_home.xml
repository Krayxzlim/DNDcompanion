<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageButton android:id="@+id/home_inventory" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/fragua_medallion" android:padding="10dp" android:src="@drawable/ic_inventory" android:contentDescription="Inventario"/>
  <TextView android:id="@+id/home_identity" style="@style/FraguaControl" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:textSize="20sp" tools:text="Kaelthar
Elfo · Mago · Nivel 5"/>
  <TextView android:id="@+id/home_notes" style="@style/FraguaControl" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/fragua_medallion" android:text="Notas" android:textSize="12sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="170dp" android:gravity="center_vertical">
  <TextView android:id="@+id/home_ac" style="@style/FraguaTitle" android:layout_width="60dp" android:layout_height="88dp" android:background="@drawable/shield_bg" tools:text="CA
12"/>
  <FrameLayout android:id="@+id/home_portrait" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
  <TextView android:id="@+id/home_speed" style="@style/FraguaText" android:layout_width="64dp" android:layout_height="84dp" android:gravity="center" android:background="@drawable/fragua_medallion" tools:text="30 ft
Velocidad"/>
 </LinearLayout>
 <TextView android:id="@+id/home_hp_status" style="@style/FraguaText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="11sp" android:textColor="#A3B9BE"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="vertical" android:background="@drawable/fragua_panel" android:padding="12dp" android:layout_marginVertical="8dp">
  <TextView android:id="@+id/home_xp_label" style="@style/FraguaText" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="NIVEL 5                        6.500 / 14.000 XP"/>
  <ProgressBar android:id="@+id/home_xp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="7dp" android:progressDrawable="@drawable/fragua_xp" android:max="1000"/>
 </LinearLayout>
 <TextView android:id="@+id/home_companion" style="@style/FraguaControl" android:layout_width="match_parent" android:layout_height="70dp" android:text="Compañero / Familiar  ›
Ver vínculo y ficha" android:textSize="19sp"/>
 <TextView android:id="@+id/home_configure" style="@style/FraguaControl" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Completar la ficha para jugar" android:visibility="gone"/>
 <FrameLayout android:id="@+id/home_wheel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="8dp" android:layout_marginHorizontal="20dp"/>
 <LinearLayout android:id="@+id/home_combat" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <LinearLayout android:id="@+id/home_left_weapon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"/>
  <TextView android:id="@+id/home_rest" style="@style/FraguaControl" android:layout_width="94dp" android:layout_height="106dp" android:layout_marginHorizontal="4dp" android:background="@drawable/fragua_medallion" android:text="DESCANSAR" android:textSize="12sp"/>
  <LinearLayout android:id="@+id/home_right_weapon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"/>
 </LinearLayout>
 <TextView android:id="@+id/home_missions" style="@style/FraguaControl" android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="8dp" android:text="Misiones  ›
Ver misiones activas y disponibles" android:gravity="center_vertical" android:paddingHorizontal="18dp"/>
</merge>