<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/fragua_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/fondo" android:paddingHorizontal="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:gravity="center_vertical">
  <TextView android:id="@+id/fragua_menu" style="@style/FraguaControl" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:text="☰" android:textSize="28sp" android:contentDescription="Abrir navegación"/>
  <TextView android:id="@+id/fragua_title" style="@style/FraguaTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableTop="@drawable/ic_fragua_fire" android:text="FRAGUA" android:textSize="30sp"/>
  <TextView android:id="@+id/fragua_refresh" style="@style/FraguaControl" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:text="↻" android:textSize="28sp" android:contentDescription="Sincronizar ficha"/>
 </LinearLayout>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#B79654"/>
 <TextView android:id="@+id/fragua_status" style="@style/FraguaText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:gravity="center" android:textColor="#A3B9BE"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:id="@+id/fragua_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="24dp"/>
 </ScrollView>
</LinearLayout>
